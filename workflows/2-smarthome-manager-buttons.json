        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://your-company.odoo.com/json/2/crm.lead/write",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
