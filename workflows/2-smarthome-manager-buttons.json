      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "\nconst q = $json.callback_query;\nconst [action, id] = String(q.data || '').split(':');\nreturn [{ json: { action, id: Number(id), query_id: q.id, chat_id: q.message.chat.id, user: q.from.first_name || q.from.username } }];\n"
      }
    },
