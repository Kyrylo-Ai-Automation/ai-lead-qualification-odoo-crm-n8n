      "parameters": {
        "jsCode": "\n// SLA для демо: 30 хв без реакції. У проді — налаштовується.\nconst SLA_MIN = 30;\nconst d = new Date(Date.now() - SLA_MIN * 60000);\nconst cut = d.toISOString().slice(0,19).replace('T',' ');\nreturn [{ json: { cut, SLA_MIN } }];\n"
      }
    },
